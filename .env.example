# ==================================
# Proxicare - Environment Configuration
# ==================================
# Copy this file to .env and fill in the values

# ==================================
# General
# ==================================
NODE_ENV=production

# ==================================
# Frontend (Next.js)
# ==================================
FRONT_PORT=3001
AUTH0_SECRET=<generate-with-openssl-rand-hex-32>
AUTH0_BASE_URL=https://www.proxicare.ovh
AUTH0_ISSUER_BASE_URL=https://YOUR_AUTH0_DOMAIN
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://YOUR_API_AUDIENCE/

# ==================================
# Backend (Express API)
# ==================================
API_PORT=3000
DB_NAME=proxicare
DB_USER=proxicare
DB_PASSWORD=change_me_strong_password
AUTH0_DOMAIN=YOUR_AUTH0_DOMAIN
API_CORS=https://www.proxicare.ovh

# ==================================
# pgAdmin (dev profile only)
# ==================================
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@proxicare.com
PGADMIN_PASSWORD=admin

# ==================================
# Domain & SSL (production)
# ==================================
DOMAIN=proxicare.ovh
CERTBOT_EMAIL=your-email@example.com
